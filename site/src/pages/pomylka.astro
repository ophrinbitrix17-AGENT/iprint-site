---
/** Ошибка отправки формы без JavaScript (обработчик перенаправляет сюда). Не индексируется. */
import Base from '../layouts/Base.astro';
import ServiceMessage from '../components/ServiceMessage.astro';
import pages from '../content/pages.json';
const t = pages.error;
---
<Base title={t.title} description={t.text} noindex>
