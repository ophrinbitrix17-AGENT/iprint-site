---
import Base from '../layouts/Base.astro';
import ServiceMessage from '../components/ServiceMessage.astro';
import pages from '../content/service-pages.json';
const t = pages.thanks;
---
<Base title={t.title} description={t.text} noindex>
  <ServiceMessage h1={t.h1} text={t.text} back={t.back} errorH1={t.errorH1} errorText={t.errorText} />
</Base>
