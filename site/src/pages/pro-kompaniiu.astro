---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import ContentSections from '../components/ContentSections.astro';
import site from '../content/site.json';
import pages from '../content/pages.json';
import { breadcrumbs, webPage } from '../lib/schema';
const p = pages.about;
const path = `/${p.slug}/`;
const crumbs = [{ label: site.ui.home, href: '/' }, { label: p.h1, href: path }];
---
<Base title={p.title} description={p.description} schema={[webPage('AboutPage', path, p.h1, p.description, p.updated), breadcrumbs(crumbs)]}>
  <PageHeader crumbs={crumbs} h1={p.h1} lead={p.lead} updated={p.updated} draft={p.draft} />
  <div class="section"><div class="wrap"><ContentSections sections={p.sections} /></div></div>
</Base>
