---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import ContentSections from '../components/ContentSections.astro';
import site from '../content/site.json';
import pages from '../content/pages.json';
import { breadcrumbs, webPage } from '../lib/schema';
const p = pages.privacy;
const path = `/${p.slug}/`;
const crumbs = [{ label: site.ui.home, href: '/' }, { label: p.h1, href: path }];
---
<Base title={p.title} description={p.description} schema={[webPage('WebPage', path, p.h1, p.description, p.updated), breadcrumbs(crumbs)]}>
  <PageHeader crumbs={crumbs} h1={p.h1} lead={p.lead} updated={p.updated} draft={p.draft} />
  <div class="section">
    <div class="wrap">
      <ContentSections sections={p.sections} />
      <p class="contact-line">{pages.contacts.labels.phone}: <a href={`tel:${site.phone}`}>{site.phoneDisplay}</a> · {pages.contacts.labels.email}: <a href={`mailto:${site.email}`}>{site.email}</a></p>
    </div>
  </div>
</Base>
<style>
  .contact-line { margin-top: 32px; }
  .contact-line a { font-weight: var(--fw-bold); text-decoration: underline; text-underline-offset: 3px; display: inline-flex; min-height: var(--tap); align-items: center; }
</style>
