---
/** Нижний призыв: тёмная сцена, лаймовая кнопка, полоса и растр. Сюда позже встанет форма → Telegram. */
import site from '../content/site.json';
import Icon from './Icon.astro';
interface Props { data: { id?: string; title: string; text: string; primary: { label: string; href?: string; action?: 'email' } } }
const { data } = Astro.props;
// временно, до формы → Telegram: письмо на адрес из site.json
const primaryHref = data.primary.action === 'email'
  ? `mailto:${site.email}?subject=${encodeURIComponent(site.ui.emailSubject)}`
  : data.primary.href;
---
<section class="cta stage" id={data.id} aria-labelledby="cta-title">
  <div class="wrap cta__grid">
    <div>
      <h2 class="h2" id="cta-title">{data.title}</h2>
      <p class="cta__text">{data.text}</p>
    </div>
    <div class="cta__actions">
      <a class="btn btn--primary" href={primaryHref}>{data.primary.label}<Icon name="arrow" /></a>
      {site.telegram && <a class="btn btn--ghost" href={site.telegram} rel="noopener">{site.ui.writeTelegram}</a>}
      <a class="btn btn--ghost" href={`tel:${site.phone}`}><Icon name="phone" />{site.phoneDisplay}</a>
    </div>
  </div>
</section>

<style>
  .cta { position: relative; padding: 48px 0; background: var(--bg); color: var(--text); border-top: 6px solid var(--lime-dark); }
  .cta::before { content: ""; position: absolute; right: 0; top: 0; width: 45%; height: 100%; pointer-events: none; opacity: .35;
    background-image: radial-gradient(circle, var(--lime-dark) 1.3px, transparent 1.8px); background-size: 10px 10px;
    -webkit-mask-image: radial-gradient(ellipse 90% 80% at 100% 30%, #000 0%, transparent 75%); mask-image: radial-gradient(ellipse 90% 80% at 100% 30%, #000 0%, transparent 75%); }
  .cta__grid { position: relative; display: grid; gap: 24px; }
  .cta__text { margin-top: 12px; font-size: var(--fs-cta-text); max-width: 56ch; color: var(--muted); }
  .cta__actions { display: flex; flex-wrap: wrap; gap: 10px; }
  @media (min-width: 1100px) {
    .cta { padding: 72px 0; }
    .cta__grid { grid-template-columns: 1.4fr 1fr; align-items: end; gap: 40px; }
    .cta__actions { justify-content: flex-end; }
  }
</style>
