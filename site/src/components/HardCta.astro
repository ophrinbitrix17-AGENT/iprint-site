---
/** Нижний блок «Запит»: тёмная сцена, текст + альтернативные контакты слева, форма справа (на телефоне — друг под другом). */
import site from '../content/site.json';
import Icon from './Icon.astro';
import LeadForm from './LeadForm.astro';
interface Props { data: { id?: string; title: string; text: string } }
const { data } = Astro.props;
---
<section class="cta stage" id={data.id} aria-labelledby="cta-title">
  <div class="wrap cta__grid">
    <div class="cta__intro">
      <h2 class="h2" id="cta-title">{data.title}</h2>
      <p class="cta__text">{data.text}</p>
      <p class="cta__alt-title">{site.telegram ? site.ui.contactAlt : site.ui.contactAltPhone}</p>
      <div class="cta__actions">
        {site.telegram && <a class="btn btn--ghost" href={site.telegram} rel="noopener"><Icon name="telegram" />{site.ui.writeTelegram}</a>}
        <a class="btn btn--ghost cta__phone" href={`tel:${site.phone}`}><Icon name="phone" />{site.phoneDisplay}</a>
      </div>
    </div>
    <LeadForm />
  </div>
</section>

<style>
  .cta { position: relative; padding: var(--section-y) 0; background: var(--bg); color: var(--text); border-top: 6px solid var(--accent); }
  .cta::before { content: ""; display: none; position: absolute; right: 0; top: 0; width: 40%; height: 340px; pointer-events: none; opacity: .3;
    background-image: radial-gradient(circle, var(--accent) 1.3px, transparent 1.8px); background-size: 10px 10px;
    -webkit-mask-image: radial-gradient(ellipse 90% 60% at 100% 10%, #000 0%, transparent 70%); mask-image: radial-gradient(ellipse 90% 60% at 100% 10%, #000 0%, transparent 70%); }
  .cta__grid { position: relative; display: grid; gap: 28px; }
  .cta__text { margin-top: 12px; font-size: var(--fs-cta-text); max-width: 56ch; color: var(--muted); }
  .cta__alt-title { margin-top: 24px; font-weight: 600; }
  .cta__actions { display: flex; flex-wrap: wrap; align-items: center; gap: 10px 20px; margin-top: 10px; }
  /* компьютер: номер — текст с иконкой, а не кнопка (звонок с ПК — не главный путь; tel: остаётся для Mac→iPhone и Phone Link). Решение 28.11 */
  @media (min-width: 900px) {
    .cta__phone { min-height: 44px; padding: 0; border-color: transparent; font-size: var(--fs-body); user-select: text; }
    .cta__phone:hover { border-color: transparent; text-decoration: underline; text-underline-offset: 3px; }
  }
  /* две колонки — только с 1100 px: на 900–1099 форма в колонке ~400 px сжимается (рецензия 27.11) */
  @media (min-width: 1100px) {
    .cta::before { display: block; }   /* на широком экране растр в углу над формой, не под текстом */
    .cta__grid { grid-template-columns: 1fr 1.15fr; align-items: start; gap: 56px; }
    .cta__intro { position: sticky; top: calc(var(--header-h) + 24px); }
  }
</style>
