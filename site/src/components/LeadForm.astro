---
/**
 * Форма заявки → POST /api/lead (Cloudflare Worker → Telegram).
 * Работает и без JavaScript (обычная отправка → страница /dyakuyemo/).
 * С JavaScript — отправка без перезагрузки, сообщения в aria-live.
 * Варианты «Що потрібно» — из карточек услуг (любое число).
 */
import site from '../content/site.json';
import home from '../content/home.json';
const f = home.hardCta.form;
const needs = [...home.products.cards.map((c) => c.title), f.needs.other];
const turnstileKey = import.meta.env.PUBLIC_TURNSTILE_SITEKEY as string | undefined;
---
<form class="lead" id="zapyt-forma" action="/api/lead" method="post" enctype="multipart/form-data" novalidate data-lead
  data-msgs={JSON.stringify({ sending: f.sending, success: f.success, successTest: f.successTest, submit: f.submit, errors: f.errors })}>
  <h3 class="lead__title">{f.title}</h3>

  <div class="lead__row">
    <div class="field">
      <label for="lead-name">{f.name.label} <span aria-hidden="true">*</span></label>
      <input id="lead-name" name="name" type="text" required maxlength="80" autocomplete={f.name.autocomplete} aria-describedby="lead-name-err" />
      <p class="field__err" id="lead-name-err" hidden></p>
    </div>
    <div class="field">
      <label for="lead-contact">{f.contact.label} <span aria-hidden="true">*</span></label>
      <input id="lead-contact" name="contact" type="text" required maxlength="120" inputmode="text" autocomplete={f.contact.autocomplete} aria-describedby="lead-contact-hint lead-contact-err" />
      <p class="field__hint" id="lead-contact-hint">{f.contact.hint}</p>
      <p class="field__err" id="lead-contact-err" hidden></p>
    </div>
  </div>

  <fieldset class="field chips">
    <legend>{f.needs.label}</legend>
    <div class="chips__list">
      {needs.map((n, i) => (
        <label class="chip"><input type="checkbox" name="needs" value={n} id={`lead-need-${i}`} /><span>{n}</span></label>
      ))}
    </div>
  </fieldset>

  <fieldset class="field chips">
    <legend>{f.qty.label}</legend>
    <div class="chips__list">
      {f.qty.options.map((q) => (
        <label class="chip"><input type="radio" name="qty" value={q} /><span>{q}</span></label>
      ))}
    </div>
  </fieldset>

  <div class="field">
    <label for="lead-file">{f.file.label}</label>
    <div class="filepick">
      <input id="lead-file" name="file" type="file" class="filepick__input"
        accept=".pdf,.ai,.eps,.svg,.png,.jpg,.jpeg,.tif,.tiff,.psd,.cdr,.zip,.rar,.7z,.webp" aria-describedby="lead-file-hint lead-file-err" />
      <label for="lead-file" class="btn btn--ghost filepick__btn" aria-hidden="true">{f.file.button}</label>
      <span class="filepick__name" data-file-name data-empty={f.file.empty}>{f.file.empty}</span>
    </div>
    <p class="field__hint" id="lead-file-hint">{f.file.hint}</p>
    <p class="field__err" id="lead-file-err" hidden></p>
  </div>

  <div class="field">
    <label for="lead-comment">{f.comment.label}</label>
    <textarea id="lead-comment" name="comment" rows="3" maxlength="2000" placeholder={f.comment.placeholder}></textarea>
  </div>

  {/* ловушка для ботов — люди её не видят */}
  <div class="hp" aria-hidden="true"><label>Website <input type="text" name="website" tabindex="-1" autocomplete="off" /></label></div>
  <input type="hidden" name="t" value="" data-lead-time />

  {turnstileKey && <div class="cf-turnstile" data-sitekey={turnstileKey} data-language="uk"></div>}

  <p class="lead__consent">{f.consent} <a href={site.legal.privacyHref}>{site.ui.privacyLink}</a>.</p>
  <button class="btn btn--primary lead__submit" type="submit">{f.submit}</button>
  <p class="lead__status" role="status" aria-live="polite" data-lead-status></p>
  <p class="lead__alt">{site.ui.orCall} <a href={`tel:${site.phone}`}>{site.phoneDisplay}</a></p>
</form>
{turnstileKey && <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>}

<script>
  const form = document.querySelector<HTMLFormElement>('[data-lead]');
  if (form) {
    const msgs = JSON.parse(form.dataset.msgs ?? '{}');
    const status = form.querySelector<HTMLElement>('[data-lead-status]')!;
    const btn = form.querySelector<HTMLButtonElement>('.lead__submit')!;
    const time = form.querySelector<HTMLInputElement>('[data-lead-time]');
    if (time) time.value = String(Date.now());
    // имя выбранного файла (родная подпись браузера может быть не на украинском)
    const fileIn = form.querySelector<HTMLInputElement>('#lead-file');
    const fileName = form.querySelector<HTMLElement>('[data-file-name]');
    const showFile = () => { if (fileName) fileName.textContent = fileIn?.files?.[0]?.name ?? fileName.dataset.empty ?? ''; };
    fileIn?.addEventListener('change', showFile);
    form.addEventListener('reset', () => setTimeout(showFile));

    const setErr = (field: string, text: string | null) => {
      const input = form.querySelector<HTMLInputElement>(`[name="${field}"]`);
      const err = form.querySelector<HTMLElement>(`#lead-${field}-err`);
      if (input) input.setAttribute('aria-invalid', text ? 'true' : 'false');
      if (err) { err.textContent = text ?? ''; err.hidden = !text; }
    };
    const clear = () => ['name', 'contact', 'file'].forEach((f) => setErr(f, null));

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      clear();
      status.className = 'lead__status';
      // проверка обязательных полей в браузере
      let first: HTMLElement | null = null;
      for (const f of ['name', 'contact']) {
        const el = form.querySelector<HTMLInputElement>(`[name="${f}"]`)!;
        if (!el.value.trim()) { setErr(f, msgs.errors.required); first ??= el; }
      }
      if (first) { first.focus(); return; }

      btn.disabled = true; btn.textContent = msgs.sending; status.textContent = '';
      try {
        const res = await fetch(form.action, { method: 'POST', body: new FormData(form), headers: { accept: 'application/json' } });
        const data = await res.json().catch(() => ({ ok: false, error: 'default' }));
        if (data.ok) {
          form.reset(); if (time) time.value = String(Date.now());
          status.textContent = data.test ? msgs.successTest : msgs.success;
          status.classList.add('lead__status--ok');
        } else {
          const text = msgs.errors[data.error] ?? msgs.errors.default;
          if (data.field) { setErr(data.field, text); form.querySelector<HTMLElement>(`[name="${data.field}"]`)?.focus(); }
          status.textContent = text; status.classList.add('lead__status--err');
        }
      } catch {
        status.textContent = msgs.errors.default; status.classList.add('lead__status--err');
      } finally {
        btn.disabled = false; btn.textContent = msgs.submit;
      }
    });
  }
</script>

<style>
  .lead { display: grid; gap: 18px; padding: 22px; border-radius: var(--radius-l); background: var(--surface); border: 1px solid var(--line); color: var(--text); }
  .lead__title { font-size: var(--fs-h3); font-weight: var(--fw-bold); }
  .lead__row { display: grid; gap: 18px; }
  .field { display: grid; gap: 6px; margin: 0; padding: 0; border: 0; min-width: 0; align-content: start; }
  .field label, .field legend { font-weight: 600; font-size: var(--fs-ui); padding: 0; }
  .field input[type="text"], .field textarea {
    width: 100%; min-height: 48px; padding: 12px 14px; border-radius: var(--radius-s);
    border: 1.5px solid var(--line-strong); background: var(--bg); color: var(--text); font: inherit; font-size: var(--fs-body);
  }
  .field textarea { resize: vertical; min-height: 96px; }
  .filepick { position: relative; display: flex; align-items: center; gap: 12px; flex-wrap: wrap; }
  .filepick__input { position: absolute; inset: 0; width: 100%; height: 100%; opacity: 0; cursor: pointer; }
  .filepick__btn { pointer-events: none; }
  .filepick__input:focus-visible + .filepick__btn { outline: 2.5px solid var(--focus); outline-offset: 3px; }
  .filepick__name { color: var(--muted); font-size: var(--fs-small); overflow-wrap: anywhere; min-width: 0; }
  .field input:focus-visible, .field textarea:focus-visible { outline: 2.5px solid var(--focus); outline-offset: 1px; }
  .field [aria-invalid="true"] { border-color: var(--danger); }
  .field__hint { font-size: var(--fs-small); color: var(--muted); }
  .field__err { font-size: var(--fs-small); color: var(--danger); font-weight: 600; }
  .chips__list { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 4px; }
  .chip { position: relative; display: inline-flex; }
  .chip input { position: absolute; opacity: 0; width: 1px; height: 1px; }
  .chip span { display: inline-flex; align-items: center; min-height: var(--tap); padding: 0 14px; border-radius: 999px; border: 1.5px solid var(--line-strong); font-size: var(--fs-ui); font-weight: 500; cursor: pointer; user-select: none; }
  .chip input:checked + span { background: var(--accent); border-color: var(--accent); color: var(--btn-fg); font-weight: var(--fw-bold); }
  .chip input:focus-visible + span { outline: 2.5px solid var(--focus); outline-offset: 2px; }
  .hp { position: absolute; left: -9999px; width: 1px; height: 1px; overflow: hidden; }
  .lead__consent { font-size: var(--fs-small); color: var(--muted); }
  .lead__consent a { color: var(--text); text-decoration: underline; text-underline-offset: 3px; }
  .lead__submit { width: 100%; }
  .lead__submit:disabled { opacity: .7; cursor: progress; }
  .lead__status:empty { display: none; }
  .lead__status { padding: 12px 14px; border-radius: var(--radius-s); font-weight: 600; }
  .lead__status--ok { background: var(--ok-bg); color: var(--ok-fg); }
  .lead__status--err { background: var(--danger-bg); color: var(--danger-fg); }
  .lead__alt { font-size: var(--fs-small); color: var(--muted); }
  .lead__alt a { color: var(--text); font-weight: var(--fw-bold); text-decoration: underline; text-underline-offset: 3px; display: inline-flex; min-height: var(--tap); align-items: center; }
  @media (min-width: 700px) { .lead { padding: 28px; } .lead__row { grid-template-columns: 1fr 1fr; } }
</style>
