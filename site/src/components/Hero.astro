---
/** Первый экран: один статичный Hero (без слайдера). Тёмная «сцена». */
import { Picture } from 'astro:assets';
import { img } from '../lib/images';
import Icon from './Icon.astro';
interface Props { data: { eyebrow?: string; title: string; lead?: string; image?: string | null; imageAlt?: string; imageDraft?: string; imageFocus?: string; imageFocusDesktop?: string; primary?: { label: string; href: string }; secondary?: { label: string; href: string } } }
const { data } = Astro.props;
const photo = img(data.image);
---
<section class="hero stage" aria-labelledby="hero-title" style={`--focus-m: ${data.imageFocus ?? '50% 50%'}; --focus-d: ${data.imageFocusDesktop ?? data.imageFocus ?? '50% 50%'}`}>
  <div class="hero__media">
    {photo && (
      <Picture src={photo} alt={data.imageAlt ?? ''} formats={['avif', 'webp']} widths={[480, 768, 1080, 1440]}
        sizes="(min-width: 1100px) 50vw, 100vw" loading="eager" fetchpriority="high" class="hero__img" />
    )}
    {data.imageDraft && <span class="draft hero__draft" aria-hidden="true">{data.imageDraft}</span>}
  </div>
  <div class="hero__body">
    <div class="wrap">
      <div class="hero__inner">
        <hgroup>
          {data.eyebrow && <p class="eyebrow"><span>{data.eyebrow}</span></p>}
          <h1 class="h1" id="hero-title">{data.title}</h1>
          {data.lead && <p class="lead hero__lead">{data.lead}</p>}
        </hgroup>
        <div class="hero__actions">
          {data.primary && <a class="btn btn--primary" href={data.primary.href}>{data.primary.label}<Icon name="arrow" /></a>}
          {data.secondary && <a class="hero__more" href={data.secondary.href}>{data.secondary.label}</a>}
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero { position: relative; overflow: hidden; background: var(--bg); color: var(--text); }
  .hero__media { position: relative; aspect-ratio: 4 / 3; max-height: 52svh; width: 100%; overflow: hidden; background: var(--surface); }
  .hero__media :global(picture), .hero__media :global(img) { position: absolute; inset: 0; display: block; width: 100%; height: 100%; }
  .hero__media :global(img) { width: 100%; height: 100%; object-fit: cover; object-position: var(--focus-m); }
  .hero__media::after { content: ""; position: absolute; inset: 0; background: linear-gradient(180deg, transparent 38%, var(--bg) 100%); pointer-events: none; }
  .hero__draft { position: absolute; left: max(12px, env(safe-area-inset-left)); top: 12px; z-index: 2; }
  .hero__body { position: relative; z-index: 2; margin-top: -48px; padding-bottom: 44px; }
  .hero .eyebrow { font-size: var(--fs-eyebrow-hero); letter-spacing: .06em; }
  .hero__lead { margin-top: 14px; }
  .hero__actions { display: flex; flex-wrap: wrap; align-items: center; gap: 10px 24px; margin-top: 22px; }
  .hero__actions .btn { flex: 1 1 auto; }
  /* второе действие — тихая текстовая ссылка, не вторая кнопка */
  .hero__more { display: inline-flex; align-items: center; min-height: var(--tap); font-weight: var(--fw-semi); text-decoration: underline; text-decoration-color: var(--accent); text-decoration-thickness: 2px; text-underline-offset: 5px; }
  .hero__more:hover { color: var(--accent); }

  @media (min-width: 700px) {
    .hero__media { aspect-ratio: 16 / 10; max-height: 60svh; }
    .hero__body { margin-top: -96px; }
    .hero__actions .btn { flex: 0 0 auto; }
  }
  /* телефон лёжа: первый экран должен вместить заголовок и кнопку */
  @media (orientation: landscape) and (max-height: 520px) {
    .hero__media { max-height: 30svh; }
    .hero__body { margin-top: -32px; padding-bottom: 24px; }
    .hero .eyebrow { display: none; }
    .hero :global(.h1) { font-size: var(--fs-h1-compact); }
    .hero__media::after { background: linear-gradient(180deg, transparent 60%, var(--bg) 100%); }
    .hero__media :global(img) { object-position: var(--focus-d); }
    .hero__lead { margin-top: 6px; }
    .hero__actions { margin-top: 12px; }
  }
  @media (min-width: 1100px) {
    /* под Hero всегда видно ≥ 200 px следующего раздела (аудит 26.11 Б7) */
    .hero { min-height: min(calc(100svh - var(--header-h) - 200px), 760px); display: flex; align-items: center; }
    .hero__media { position: absolute; top: 0; right: 0; bottom: 0; width: 48%; aspect-ratio: auto; max-height: none; }
    .hero__media :global(img) { object-position: var(--focus-d); }
    .hero__media::after { background: linear-gradient(90deg, var(--bg) 0%, transparent 30%); }
    .hero__body { margin: 0; padding: 96px 0; width: 100%; }
    .hero__inner { max-width: 52%; }
  }
  /* невысокие окна (ноутбук 1366×768, масштаб Windows 125–150 %, браузер 110 %): отступы и H1 плавно зависят от высоты окна,
     чтобы «Виробництво без зайвих ризиків» было видно в первом экране (аудит 27.11; выше 950 px — без изменений) */
  @media (min-width: 1100px) and (max-height: 950px) {
    .hero__body { padding: clamp(28px, 7svh, 96px) 0; }
    .hero :global(.h1) { font-size: clamp(44px, 8svh, var(--fs-h1)); }
    :global(.hero + .section) { padding-top: clamp(40px, 8svh, 112px); }
  }
  /* планшет лёжа (1024×768 и т. п.) */
  @media (min-width: 700px) and (max-width: 1099px) and (orientation: landscape) and (min-height: 521px) {
    .hero__media { max-height: 38svh; }
    /* полоса ~3,5:1 — темнее низ под надписью, кадр чуть выше центра принта (рецензия 27.11) */
    .hero__media::after { background: linear-gradient(180deg, transparent 5%, var(--bg) 82%); }
    .hero__media :global(img) { object-position: 50% 40%; }
    :global(.hero + .section) { padding-top: 56px; }
  }
</style>
