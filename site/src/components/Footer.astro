---
/** Подвал: тёмная сцена. Контакты, навигация, соцсети (появляются, когда владелец даст ссылки). */
import site from '../content/site.json';
import home from '../content/home.json';
import Logo from './Logo.astro';
import Icon from './Icon.astro';
const year = new Date().getFullYear();
---
<footer class="ftr stage" id="kontakty">
  <div class="wrap">
    <div class="ftr__grid">
      <div>
        <Logo />
        <p class="ftr__tag muted">{site.tagline}. {site.city}.</p>
        {(site.telegram || site.instagram) && (
          <div class="ftr__social">
            {site.telegram && <a class="icon-btn" href={site.telegram} rel="noopener" aria-label="Telegram"><Icon name="telegram" /></a>}
            {site.instagram && <a class="icon-btn" href={site.instagram} rel="noopener" aria-label="Instagram"><Icon name="instagram" /></a>}
          </div>
        )}
      </div>
      <nav aria-label={home.products.eyebrow}>
        <p class="ftr__h">{home.products.eyebrow}</p>
        <ul class="ftr__list">
          {home.products.cards.map((c) => <li>{c.href ? <a href={c.href}>{c.title}</a> : <span>{c.title}</span>}</li>)}
        </ul>
      </nav>
      <nav aria-label={home.tech.eyebrow}>
        <p class="ftr__h">{home.tech.eyebrow}</p>
        <ul class="ftr__list">
          {home.tech.cards.map((c) => <li>{c.href ? <a href={c.href}>{c.title}</a> : <span>{c.title}</span>}</li>)}
        </ul>
      </nav>
      <div>
        <p class="ftr__h">{site.ui.footerContacts}</p>
        <ul class="ftr__list">
          <li><a href={`tel:${site.phone}`}>{site.phoneDisplay}</a></li>
          <li><a href={`mailto:${site.email}`}>{site.email}</a></li>
          <li><span>{site.city}, {site.countryName}</span></li>
          {site.hours && <li><span>{site.hours}</span></li>}
        </ul>
      </div>
    </div>
    <div class="ftr__copy">
      <span>© {site.foundingYear}–{year} {site.name}</span>
    </div>
  </div>
</footer>

<style>
  .ftr { padding: 44px 0 calc(96px + env(safe-area-inset-bottom)); background: var(--bg); color: var(--text); border-top: 1px solid var(--line); }
  .ftr__grid { display: grid; gap: 28px; }
  .ftr__tag { margin-top: 10px; max-width: 34ch; }
  .ftr__social { display: flex; gap: 8px; margin-top: 14px; }
  .ftr__h { font-size: var(--fs-eyebrow); letter-spacing: .08em; text-transform: uppercase; color: var(--muted); font-weight: var(--fw-bold); margin-bottom: 4px; }
  .ftr__list { list-style: none; }
  .ftr__list a, .ftr__list span { display: inline-flex; align-items: center; min-height: var(--tap); }
  .ftr__list span { color: var(--muted); }
  .ftr__list a:hover { color: var(--accent-ink); }
  .ftr__copy { margin-top: 28px; padding-top: 18px; border-top: 1px solid var(--line); font-size: var(--fs-small); color: var(--muted); }
  .ftr__grid { grid-template-columns: 1fr 1fr; }
  .ftr__grid > :first-child, .ftr__grid > :last-child { grid-column: 1 / -1; }
  @media (min-width: 700px) { .ftr__grid { grid-template-columns: 1.4fr 1fr 1fr; } .ftr__grid > :first-child { grid-column: auto; } }
  @media (min-width: 1100px) { .ftr { padding-bottom: 44px; } .ftr__grid { grid-template-columns: 1.6fr 1fr 1fr 1fr; } .ftr__grid > :last-child { grid-column: auto; } }
</style>
