---
/** Подвал (компактный, аудит 26.11 Б10): лого + дескриптор, контакты в <address>, соцсети/адрес/график — только когда владелец их передал; строка ссылок на страницы и копирайт. Тексты — site.json → footer. */
import site from '../content/site.json';
import Logo from './Logo.astro';
import Icon from './Icon.astro';
const year = new Date().getFullYear();
const addr = (site as { address?: string | null }).address;
---
<footer class="ftr stage">
  <div class="wrap">
    <div class="ftr__main">
      <div class="ftr__brand">
        <Logo />
        <p class="ftr__tag muted">{site.tagline}. {site.city}.</p>
      </div>
      <address class="ftr__contacts">
        <a href={`tel:${site.phone}`}><Icon name="phone" />{site.phoneDisplay}</a>
        <a href={`mailto:${site.email}`}><Icon name="mail" />{site.email}</a>
        {addr && <span class="ftr__plain">{addr}</span>}
        {site.hours && <span class="ftr__plain">{site.hours}</span>}
        {(site.telegram || site.instagram) && (
          <span class="ftr__social">
            {site.telegram && <a class="icon-btn" href={site.telegram} rel="noopener" aria-label="Telegram"><Icon name="telegram" /></a>}
            {site.instagram && <a class="icon-btn" href={site.instagram} rel="noopener" aria-label="Instagram"><Icon name="instagram" /></a>}
          </span>
        )}
      </address>
    </div>
    <div class="ftr__bottom">
      <nav aria-label={site.footer.navLabel}>
        <ul class="ftr__links" role="list">
          {site.footer.links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
        </ul>
      </nav>
      <p class="ftr__copy">© {site.foundingYear}–{year} {site.name}. {site.footer.rights}</p>
    </div>
  </div>
</footer>

<style>
  .ftr { padding: 40px 0 calc(96px + env(safe-area-inset-bottom)); background: var(--bg); color: var(--text); border-top: 1px solid var(--line); }
  .ftr__main { display: grid; gap: 20px; }
  .ftr__tag { margin-top: 8px; max-width: 34ch; }
  .ftr__contacts { font-style: normal; display: flex; flex-direction: column; align-items: flex-start; }
  .ftr__contacts > a { display: inline-flex; align-items: center; gap: 10px; min-height: var(--tap); font-weight: 600; overflow-wrap: anywhere; }
  .ftr__contacts > a:hover, .ftr__links a:hover { color: var(--accent-ink); }
  .ftr__contacts :global(svg) { width: 18px; height: 18px; flex: none; color: var(--muted); }
  .ftr__plain { display: inline-flex; align-items: center; min-height: var(--tap); color: var(--muted); }
  .ftr__social { display: flex; gap: 8px; margin-top: 8px; }
  .ftr__bottom { margin-top: 24px; padding-top: 12px; border-top: 1px solid var(--line); display: flex; flex-wrap: wrap; gap: 4px 24px; justify-content: space-between; align-items: center; font-size: var(--fs-small); color: var(--muted); }
  .ftr__links { list-style: none; display: flex; flex-wrap: wrap; column-gap: 20px; }
  .ftr__links a { display: inline-flex; align-items: center; min-height: var(--tap); color: var(--text); text-decoration: underline; text-decoration-color: var(--line-strong); text-underline-offset: 3px; }
  .ftr__copy { padding: 10px 0; }
  @media (min-width: 700px) {
    .ftr__main { grid-template-columns: 1fr auto; align-items: start; }
    .ftr__contacts { align-items: flex-end; }
  }
  @media (min-width: 1100px) { .ftr { padding-bottom: 40px; } }
</style>
