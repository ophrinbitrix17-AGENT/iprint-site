---
/** Каркас страницы: <head> (мета, Schema.org, тема без вспышки), шапка, подвал, липкая панель. */
import '@fontsource-variable/manrope/wght.css';
import '../styles/themes/2026-11.css';   /* ← файл стиля: рестайлинг = смена этой строки */
import '../styles/base.css';
import site from '../content/site.json';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import StickyBar from '../components/StickyBar.astro';
import logoLight from '../assets/images/logo-light-bg.svg';

interface Props { title: string; description: string; noindex?: boolean; }
const { title, description, noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, site.url).href;

const orgId = `${site.url}/#org`;
const sameAs = [site.instagram, site.telegram].filter(Boolean);
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'LocalBusiness',
      '@id': orgId,
      name: site.name,
      url: `${site.url}/`,
      logo: new URL(logoLight.src, site.url).href,
      description: site.description,
      telephone: site.phone,
      email: site.email,
      foundingDate: String(site.foundingYear),
      address: { '@type': 'PostalAddress', addressLocality: site.city, addressCountry: site.country },
      areaServed: { '@type': 'Country', name: 'Україна' },
      knowsAbout: ['шовкотрафаретний друк', 'DTF-друк', 'вишивка', 'флок', 'пошив одягу'],
      ...(sameAs.length ? { sameAs } : {}),
    },
    { '@type': 'WebSite', '@id': `${site.url}/#website`, name: site.name, url: `${site.url}/`, inLanguage: 'uk', publisher: { '@id': orgId } },
  ],
};
---
<!doctype html>
<html lang="uk" data-theme="light">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  {noindex && <meta name="robots" content="noindex, nofollow" />}
  <meta name="theme-color" content="#F5F3EE" />
  <meta name="color-scheme" content="light dark" />
  <!-- Тема до отрисовки: по умолчанию светлая; тёмная — только если пользователь выбрал её переключателем -->
  <script is:inline>
    try { if (localStorage.getItem('iprint-theme') === 'dark') { document.documentElement.dataset.theme = 'dark'; document.querySelector('meta[name="theme-color"]').setAttribute('content', '#161513'); } } catch (e) {}
  </script>
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <meta property="og:type" content="website" />
  <meta property="og:locale" content="uk_UA" />
  <meta property="og:site_name" content={site.name} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
</head>
<body>
  <a class="skip-link" href="#main">Перейти до змісту</a>
  <Header />
  <main id="main">
    <slot />
  </main>
  <Footer />
  <StickyBar />
</body>
</html>
