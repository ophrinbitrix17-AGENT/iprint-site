---
/** Каркас страницы: <head> (мета, Schema.org, тема без вспышки), шапка, подвал, липкая панель. */
import '@fontsource-variable/manrope/wght.css';
import manropeCyr from '@fontsource-variable/manrope/files/manrope-cyrillic-wght-normal.woff2?url';
import '../styles/themes/2026-11.css';   /* ← файл стиля: рестайлинг = смена этой строки */
import '../styles/base.css';
import site from '../content/site.json';
import home from '../content/home.json';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import StickyBar from '../components/StickyBar.astro';

interface Props { title: string; description: string; noindex?: boolean; hideStickyBar?: boolean; schema?: Record<string, unknown>[] }
const { title, description, noindex = false, hideStickyBar = false, schema = [] } = Astro.props;
const ogImage = `${site.url}/og-image.png`;
const canonical = new URL(Astro.url.pathname, site.url).href;

// Индексация разрешена ТОЛЬКО в боевой сборке (SITE_ENV=production). Превью/зеркало — всегда noindex.
const isProduction = process.env.SITE_ENV === 'production';
const robotsNoindex = noindex || !isProduction;

const orgId = `${site.url}/#org`;
const sameAs = [site.instagram].filter(Boolean);   // t.me/iprintmanager — рабочий аккаунт менеджеров, не официальный профиль: в sameAs не ставим (рецензия 28.11)
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'LocalBusiness',
      '@id': orgId,
      name: site.name,
      url: `${site.url}/`,
      logo: `${site.url}/logo.png`,
      image: ogImage,
      description: site.description,
      telephone: site.phone,
      email: site.email,
      foundingDate: String(site.foundingYear),
      address: { '@type': 'PostalAddress', addressLocality: site.city, addressCountry: site.country },
      knowsAbout: [...home.tech.cards, ...home.products.cards].map((c) => c.title),   // из тех же данных, что и видимые карточки
      ...(sameAs.length ? { sameAs } : {}),
    },
    { '@type': 'WebSite', '@id': `${site.url}/#website`, name: site.name, url: `${site.url}/`, inLanguage: 'uk', publisher: { '@id': orgId } },
    ...schema,   // разметка конкретной страницы (AboutPage, ContactPage, BreadcrumbList …)
  ],
};
---
<!doctype html>
<html lang="uk" data-theme="light">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>{title}</title>
  <meta name="description" content={description} />
  {!noindex && <link rel="canonical" href={canonical} />}
  {robotsNoindex && <meta name="robots" content="noindex, nofollow" />}
  <meta name="theme-color" content={site.themeColors.light} data-light={site.themeColors.light} data-dark={site.themeColors.dark} />
  <meta name="color-scheme" content="light" />
  {/* Тема до отрисовки: по умолчанию светлая; тёмная — только если пользователь выбрал её переключателем */}
  <script is:inline>
    try { if (localStorage.getItem('iprint-theme') === 'dark') { document.documentElement.dataset.theme = 'dark'; var m = document.querySelector('meta[name="theme-color"]'); m.setAttribute('content', m.dataset.dark); } } catch (e) {}
  </script>
  <link rel="preload" href={manropeCyr} as="font" type="font/woff2" crossorigin />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <meta property="og:type" content="website" />
  <meta property="og:locale" content="uk_UA" />
  <meta property="og:site_name" content={site.name} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  {!noindex && <meta property="og:url" content={canonical} />}
  <meta property="og:image" content={ogImage} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content={`${site.name} — ${site.tagline}`} />
  <meta name="twitter:card" content="summary_large_image" />
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
</head>
<body>
  <a class="skip-link" href="#main">{site.ui.skipLink}</a>
  <Header />
  <main id="main">
    <slot />
  </main>
  <Footer />
  {!hideStickyBar && <StickyBar />}
</body>
</html>
